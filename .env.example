# Existing Vercel REACT_APP_* variables continue to work through next.config.ts.
# Alternatively, use the standard Next.js public names below.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_ADMIN_USERS=

# Hosted sponsorship checkout defaults to live. Use test for sandbox QA.
# No Dodo API key is required at runtime.
SPONSOR_CHECKOUT_MODE=live
# Optional product overrides (use IDs from the selected Dodo environment):
# SPONSOR_SILVER_MONTHLY_PRODUCT_ID=
# SPONSOR_SILVER_LIFETIME_PRODUCT_ID=
# SPONSOR_GOLD_MONTHLY_PRODUCT_ID=
# SPONSOR_GOLD_LIFETIME_PRODUCT_ID=
# SPONSOR_DIAMOND_MONTHLY_PRODUCT_ID=
# SPONSOR_DIAMOND_LIFETIME_PRODUCT_ID=

# Cloudflare Web Analytics credentials for the daily sync job
CLOUDFLARE_ANALYTICS_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ANALYTICS_SITE_TAG=

# First UTC day of Cloudflare tracking. Set on both the app and sync job.
SITE_VIEWS_START_DATE=

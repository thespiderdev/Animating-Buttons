# Hosted sponsorship checkout defaults to live. Use test for sandbox QA.
# Set DODO_PAYMENTS_API_KEY as a Worker secret to enable payment-first onboarding.
DODO_PAYMENTS_API_KEY=
SPONSOR_CHECKOUT_MODE=live

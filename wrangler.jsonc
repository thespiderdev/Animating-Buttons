{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "getbuttons",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "routes": [{ "pattern": "getbuttons.tech", "custom_domain": true }],
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "f367847cbc7c413dade529bd93367899",
    },
  ],
  "d1_databases": [
    {
      "binding": "PAGE_VIEWS",
      "database_name": "getbuttons-page-views",
      "database_id": "1edceb42-4fe7-4873-bc00-f5ed61bc09b9",
    },
    {
      "binding": "SPONSOR_ORDERS",
      "database_name": "getbuttons-sponsor-orders",
      "database_id": "31273146-ddb3-47fa-92ed-18aa1267d33e",
      "migrations_dir": "migrations/sponsors",
    },
  ],
  "ratelimits": [
    {
      "name": "PAGE_VIEW_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "observability": { "enabled": true },
}
